[
  {
    "description": "$ref to a false boolean definition rejects every value",
    "schema": {
      "definitions": {"never": false},
      "$ref": "#/definitions/never"
    },
    "tests": [
      {
        "description": "rejects a number",
        "data": 1,
        "valid": false
      },
      {
        "description": "rejects an object",
        "data": {},
        "valid": false
      },
      {
        "description": "rejects null",
        "data": null,
        "valid": false
      }
    ]
  },
  {
    "description": "$ref to a true boolean definition accepts every value",
    "schema": {
      "definitions": {"always": true},
      "$ref": "#/definitions/always"
    },
    "tests": [
      {
        "description": "accepts a string",
        "data": "foo",
        "valid": true
      },
      {
        "description": "accepts null",
        "data": null,
        "valid": true
      }
    ]
  },
  {
    "description": "$ref to an object definition validates against that object",
    "schema": {
      "definitions": {
        "positive": {"type": "integer", "minimum": 1}
      },
      "properties": {
        "value": {"$ref": "#/definitions/positive"}
      }
    },
    "tests": [
      {
        "description": "valid positive integer",
        "data": {"value": 5},
        "valid": true
      },
      {
        "description": "invalid negative integer",
        "data": {"value": -1},
        "valid": false
      },
      {
        "description": "invalid non-integer",
        "data": {"value": "x"},
        "valid": false
      }
    ]
  }
]
